# All credentials stay on the server. Never use VITE_ for a secret.
AI_PROVIDER=orbio
AI_BASE_URL=https://api.orbio.so/api/v1
AI_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PORT=4173

# Use the endpoint and model supported by the issuer of YOUR key.
# Orbio gateway: https://api.orbio.so/api/v1 (OpenAI-compatible chat).
# The /api base alone is for the Anthropic-compatible interface.
# Older OpenRouter-issued keys instead use https://openrouter.ai/api/v1.
# For a substitute provider, set AI_PROVIDER=development and its base/model.
