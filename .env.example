# All credentials stay on the server. Never use VITE_ for a secret.
AI_PROVIDER=development
AI_BASE_URL=https://ai.hdd.sb/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PORT=4173

# When the sponsor key is available, set AI_PROVIDER=orbio and use the
# base URL + model specified by the dashboard that issued YOUR key.
# The starter documents https://openrouter.ai/api/v1 for OpenRouter keys.
# The newer Orbio gateway may use a different endpoint. Do not guess it.
